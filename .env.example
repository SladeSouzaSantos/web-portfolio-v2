# The demo is the default, including production, until the API is explicitly enabled.
VITE_ORBE_API_ENABLED=false
VITE_AUTH_ENABLED=false
VITE_MEETINGS_ENABLED=false
VITE_API_BASE_URL=

# Local API integration (copy to .env.local and restart Vite):
# VITE_ORBE_API_ENABLED=true
# VITE_AUTH_ENABLED=true
# VITE_MEETINGS_ENABLED=false
# VITE_API_BASE_URL=https://devapi.phasscode.com
# Authentication and meetings are independent opt-ins; only the literal true enables each.
# The first DEV profile enables login while meetings remain disabled.
# VITE_PHASE3_ENABLED is no longer read. Migrate it to the two explicit flags above.
# Browser tests intercept requests. Do not send real chat requests in automation.
# These variables are public bundle configuration. Never put API keys or tokens here.
# npm run dev prints sanitized [Orbe] diagnostics in the Vite terminal and browser console.
# A local browser origin must be explicitly allowed by the published API's CORS.
# Real Google login uses secure backend cookies. Homologate it on devgbc.phasscode.com;
# cross-site localhost cookies may be restricted by SameSite. Do not relax cookie security.
