# Orbe is the only public API capability. These values are safe to embed in a Vite bundle.
VITE_ORBE_API_ENABLED=true
VITE_API_BASE_URL=https://devapi.phasscode.com
# Default 100; 0 = unlimited questions in this browser conversation only.
# Vite settings are embedded at build time, so rebuild frontend after changing.
# Does NOT disable API/provider quotas, cost budget or abuse protection.
VITE_ORBE_MAX_USER_TURNS=100
# On GitHub Actions builds set repository variable ORBE_MAX_USER_TURNS instead.
# Updating Mac Mini .env alone cannot change already-built Vite assets.

# Local development: use localhost only when listed in backend CORS_ORIGINS.
# DEV (devgbc.phasscode.com) -> https://devapi.phasscode.com
# MAIN (gbc.phasscode.com) -> https://api.phasscode.com
# Login, meetings and notifications are not part of the public portfolio.
# Keep API keys and LLM credentials only in the backend; never in VITE_* variables.
